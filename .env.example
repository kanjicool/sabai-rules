# ==========================================
# Sabai-Rules HR Benefit Hybrid GraphRAG
# Environment Configuration
# ==========================================

# Neo4j Graph Database Configuration (Phase 1)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=SecretPassword123
NEO4J_DATABASE=neo4j

# Embedding Model (Phase 2 Vector Store)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_PATH=data/faiss_index

# Ollama Local LLM (Phase 3 Hybrid RAG)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# LINE Messaging API Configuration (Phase 4 Webhook)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# FastAPI Webhook Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
