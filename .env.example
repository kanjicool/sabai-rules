# ==========================================
# Sabai-Rules HR Benefit Hybrid GraphRAG
# Environment Configuration
# ==========================================

# Neo4j Graph Database Configuration (Phase 1)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=SecretPassword123
NEO4J_DATABASE=neo4j

# Embedding Model & Vector Store (FAISS + BM25 Hybrid)
EMBEDDING_MODEL_NAME=bge-m3
VECTOR_INDEX_BACKEND=hybrid
ENABLE_HYBRID_SEARCH=True
ENABLE_RERANKING=True
ENABLE_PARENT_RETRIEVAL=True

# Ollama Local LLM (Production-Grade RAG)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# LINE Messaging API Configuration (Webhook)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LIFF Mini-App URL (HR Calculator)
CALCULATOR_URL=https://your-cloudflare-tunnel.trycloudflare.com/liff/calculator

# FastAPI Webhook Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

